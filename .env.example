# Application Configuration
APP_NAME="Python Learning Assistant (SLM)"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Cache & Storage Management (Drive D: protects Drive C:)
HF_HOME="D:/huggingface_cache"

# Model Configuration
MODEL_ID="Qwen/Qwen2.5-1.5B-Instruct"
DEVICE="cpu"
USE_4BIT=True
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.1

# Paths
DATA_DIR="data"
EXPERIMENTS_DIR="experiments"
REPORTS_DIR="reports"
ADAPTER_PATH="models/lora_adapter"
