# Application Configuration
APP_NAME="Python Learning Assistant (SLM)"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Model Configuration
# Candidate options: Qwen/Qwen2.5-1.5B-Instruct, HuggingFaceTB/SmolLM2-1.7B-Instruct, meta-llama/Llama-3.2-1B-Instruct
MODEL_ID="Qwen/Qwen2.5-1.5B-Instruct"
DEVICE="auto"
USE_4BIT=False
MAX_NEW_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.1

# Paths
DATA_DIR="data"
EXPERIMENTS_DIR="experiments"
REPORTS_DIR="reports"
ADAPTER_PATH="models/lora_adapter"
